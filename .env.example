# Backend environment (spec section 13). Copy to .env on the server; never commit .env.
# Every variable is optional: the defaults below are what runs when it is not set.
PORT=8080
APP_STORAGE_PATH=./storage
APP_MAX_FILE_SIZE=52428800
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TRIM_ENABLED=true
APP_RETENTION_HOURS=48
APP_RETENTION_SWEEP_MINUTES=60
APP_EXPORT_TIMEOUT_MS=1800000

# TIF (spec 10.2 to 10.4, 10.6)
APP_TIFF_DPI=300
APP_TIFF_MAX_MEGAPIXELS=100
APP_TIFF_MAX_HEAP_FRACTION=0.5
APP_TIFF_BAND_ROWS=1024
# TIF and cut builds share heap x APP_TIFF_MAX_HEAP_FRACTION; a cut file waits at most this long for room
APP_TIFF_BUDGET_WAIT_MS=120000
# DEFLATE or LZW
APP_TIFF_COMPRESSION=DEFLATE
APP_TIFF_COMPRESSION_QUALITY=0.3
# Path to the CMYK ICC profile (not in the repo, see docs/adr/004). Example on the server: /opt/xuong-in/color/USWebCoatedSWOP.icc
APP_TIFF_CMYK_PROFILE=
APP_TIFF_TRANSPARENT_LAYER=true
APP_TIFF_LAYER_ZIP=true
APP_TIFF_WHITE_CHANNEL=W1
APP_TIFF_WHITE_ALPHA_THRESHOLD=128
APP_TIFF_WHITE_CHOKE=1
APP_TIFF_WHITE_TOLERANCE=6

# Cut file for Graphtec CE7000-60 / Cutting Master (spec 10.5)
APP_CUT_DPI=300
APP_CUT_OFFSET_MM=0.0
APP_CUT_SIMPLIFY_MM=0.1
APP_CUT_MIN_AREA_MM2=0.2
APP_CUT_STROKE_PT=0.25
APP_CUT_SPOT_NAME=CutContour
APP_CUT_MARK_LENGTH_MM=15.0
APP_CUT_MARK_THICKNESS_MM=1.0
APP_CUT_MARK_CLEARANCE_MM=5.0
# SQUARE_WITH_EDGE, L or SQUARE_OUTLINE
APP_CUT_MARK_TOP_LEFT=SQUARE_WITH_EDGE
APP_CUT_MARK_TOP_RIGHT=SQUARE_WITH_EDGE
APP_CUT_MARK_BOTTOM_LEFT=SQUARE_WITH_EDGE
APP_CUT_MARK_BOTTOM_RIGHT=SQUARE_WITH_EDGE
APP_CUT_ARTWORK_LAYER=false
